{
  "rules": {
    "lobbies": {
      "$lobby": {
        ".read": "auth != null && (data.child('owner').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && !newData.exists() && data.child('owner').val() === auth.uid",
        ".validate": "$lobby.length <= 50 && newData.hasChild('owner')",
        "owner": {
          ".read": "auth != null",
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString()"
        },
        "guest": {
          ".read": "auth != null",
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && newData.parent().child('owner').exists() && newData.parent().child('owner').val() !== auth.uid",
          ".validate": "newData.isString()"
        },
        "$player": {
          ".write": "auth != null && ($player === 'player1' || $player === 'player2') && (newData.parent().child('owner').val() === auth.uid || newData.parent().child('guest').val() === auth.uid)",
          "ready": {
            ".validate": "newData.isString() && newData.val().matches(/^[012]$/)"
          },
          "side": {
            ".validate": "newData.isString() && newData.val().matches(/^[01]$/)"
          },
          "repeat": {
            ".validate": "newData.isString() && newData.val().matches(/^[01]$/)"
          },
          "rana": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "ranb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "ranc": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "rand": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
